# ===== SaaS — Database =====
SAAS_DB_URL=jdbc:mariadb://<host>:3306/<db_name>?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8mb4
SAAS_DB_USERNAME=
SAAS_DB_PASSWORD=

# ===== SaaS — Redis =====
SAAS_REDIS_HOST=
SAAS_REDIS_PASSWORD=

# ===== SaaS — Security =====
SAAS_CRYPTO_SECRET=
SAAS_JWT_SECRET=
# Comma-separated browser origins allowed to call the SaaS API. Blank disables CORS.
SAAS_CORS_ALLOWED_ORIGINS=

# ===== SaaS — Default Admin Passwords =====
# Required on first startup when the platform admin does not yet exist.
SAAS_ADMIN_DEFAULT_PASSWORD=
# Optional. Leave blank to skip creating the demo tenant and demo_admin account.
SAAS_DEMO_ADMIN_DEFAULT_PASSWORD=
